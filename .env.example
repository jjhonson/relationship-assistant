# Copy to .env.local (never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Random string, 32+ chars (e.g. `openssl rand -base64 32`); encrypts credential and short-lived consent tokens
SESSION_SECRET=
# Optional: max messages to sample (1-50, default 50)
GMAIL_SAMPLE_SIZE=50
# Optional: max historical messages for relationship discovery (1-200, default 200)
GMAIL_DISCOVERY_SAMPLE_SIZE=200

# Stage 2 fictional benchmark and local Stage 3 explicitly consented real-contact pilot.
# Keep real keys in .env.local; never commit them.
OPENAI_API_KEY=
# Optional relationship-inference model override (default: gpt-6.1-sol)
OPENAI_RELATIONSHIP_MODEL=gpt-6.1-sol

# Storage defaults to the existing private .data/relationships.json.
# For synthetic-only testing, opt into the Supabase backend *after* applying
# the two reviewed database migrations and configuring the server secret.
RA_STORAGE_BACKEND=json
# Never prefix these variables NEXT_PUBLIC_ and never commit actual values.
RA_SUPABASE_URL=
RA_SUPABASE_SECRET_KEY=
# Random UUID identifying a disposable test dataset; do not reuse a real-data owner.
RA_DB_OWNER_ID=

# Default: fictional. Do not activate personal use in .env.local.
RA_DATASET_MODE=fictional
# AFTER explicit owner approval, create an ignored .data/personal.env separately.
# It must explicitly specify RA_DATASET_MODE=personal, RA_STORAGE_BACKEND=supabase,
# RA_PERSONAL_DATA_ENABLED=yes and independent RA_PERSONAL_SUPABASE_URL,
# RA_PERSONAL_SUPABASE_SECRET_KEY, RA_PERSONAL_DB_OWNER_ID values.
# Never change the fictional RA_DB_OWNER_ID to the personal owner.
