# Copy to .env.local (never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Random string, 32+ chars (e.g. `openssl rand -base64 32`); encrypts the credential cookie
SESSION_SECRET=
# Optional: max messages to sample (1-50, default 50)
GMAIL_SAMPLE_SIZE=50
# Optional: max historical messages for relationship discovery (1-200, default 200)
GMAIL_DISCOVERY_SAMPLE_SIZE=200
# Optional: per-run UI plan cap for local experiment metadata details (1-1000, default 1000)
GMAIL_EXPERIMENT_DETAIL_CAP=1000
